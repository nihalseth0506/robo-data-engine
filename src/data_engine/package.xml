<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>data_engine</name>
  <version>0.1.0</version>
  <description>
    Universal robot data collection and synchronization pipeline.
    Captures time-aligned multi-modal sensor streams from heterogeneous
    robot embodiments and exports to lerobot-compatible parquet and video format.
  </description>
  <maintainer email="seth.nihal.work@gmail.com">Nihal Sanjay Seth</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>